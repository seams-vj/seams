@@ -186,6 +186,29 @@ template <typename T, typename TagT = uint32_t, typename LabelT = uint32_t> clas
     // memory should be allocated for vec before calling this function
     DISKANN_DLLEXPORT int get_vector_by_tag(TagT &tag, T *vec);
 
+    // Read access to the live graph for searches that run while other threads insert and delete. A list is copied
+    // under its location's lock (the lock insert_point, inter_insert and process_delete take to change it), so a
+    // reader sees a list as it was before or after one change, never half of it.
+    DISKANN_DLLEXPORT uint32_t start_location() const
+    {
+        return _start;
+    }
+    DISKANN_DLLEXPORT void neighbours_of(uint32_t location, std::vector<uint32_t> &neighbours)
+    {
+        LockGuard guard(_locks[location]);
+        neighbours = _graph_store->get_neighbours(location);
+    }
+    DISKANN_DLLEXPORT int64_t location_of(TagT tag)
+    {
+        std::shared_lock<std::shared_timed_mutex> lock(_tag_lock);
+        auto found = _tag_to_location.find(tag);
+        return found == _tag_to_location.end() ? -1 : (int64_t)found->second;
+    }
+    DISKANN_DLLEXPORT const T *vector_of(uint32_t location) const
+    {
+        return static_cast<InMemDataStore<T> *>(_data_store.get())->raw_vector(location);
+    }
+
     DISKANN_DLLEXPORT void print_status();
 
     DISKANN_DLLEXPORT void count_nodes_at_bfs_levels();
diff --git a/src/index.cpp b/src/index.cpp
index 4b38027d..0a515dcc 100644
--- a/src/index.cpp
+++ b/src/index.cpp
@@ -732,9 +732,40 @@ template <typename T, typename TagT, typename LabelT> int Index<T, TagT, LabelT>
 
 template <typename T, typename TagT, typename LabelT> uint32_t Index<T, TagT, LabelT>::calculate_entry_point()
 {
-    // REFACTOR TODO: This function does not support multi-threaded calculation of medoid.
-    // Must revisit if perf is a concern.
-    return _data_store->calculate_medoid();
+    // medoid of the occupied locations [0, _nd) only; the stock version also counts the zero vectors of free slots
+    const size_t dim = _data_store->get_dims();
+    std::vector<T> point(_data_store->get_aligned_dim());
+    std::vector<double> center(dim, 0.0);
+    for (uint32_t location = 0; location < _nd; location++)
+    {
+        _data_store->get_vector(location, point.data());
+        for (size_t coordinate = 0; coordinate < dim; coordinate++)
+        {
+            center[coordinate] += (double)point[coordinate];
+        }
+    }
+    for (size_t coordinate = 0; coordinate < dim; coordinate++)
+    {
+        center[coordinate] /= (double)_nd;
+    }
+    uint32_t medoid = 0;
+    double best_distance = std::numeric_limits<double>::max();
+    for (uint32_t location = 0; location < _nd; location++)
+    {
+        _data_store->get_vector(location, point.data());
+        double distance = 0;
+        for (size_t coordinate = 0; coordinate < dim; coordinate++)
+        {
+            const double difference = (double)point[coordinate] - center[coordinate];
+            distance += difference * difference;
+        }
+        if (distance < best_distance)
+        {
+            best_distance = distance;
+            medoid = location;
+        }
+    }
+    return medoid;
 }
 
 template <typename T, typename TagT, typename LabelT> std::vector<uint32_t> Index<T, TagT, LabelT>::get_init_ids()
@@ -2656,6 +2687,7 @@ template <typename T, typename TagT, typename LabelT> int Index<T, TagT, LabelT>
 
         location = _empty_slots.pop_any();
         _delete_set->erase(location);
+        _data_compacted = false; // a reused free slot leaves the occupied locations non-consecutive
     }
     ++_nd;
     return location;
